NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by the isolated production migration; never read by the browser.
POSTGRES_URL=

# Production only: identical secret on CRM and website. Provider keys stay on the website.
CRM_EMAIL_WORKER_SECRET=

# Facebook Page Messenger intake (CRM production project only)
# Subscribe this Page to messages at /api/webhooks/facebook.
FACEBOOK_PAGE_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
# Optional profile-name enrichment; missing permission does not block intake.
FACEBOOK_PAGE_ACCESS_TOKEN=
