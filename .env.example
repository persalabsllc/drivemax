# Enable only after applying the migration and creating your first staff user.
CONTROL_ROOM_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Hash salt for rate limits: generate a random 32-byte value. Never NEXT_PUBLIC.
LEAD_RATE_LIMIT_SECRET=
# Website alerts always go to sales@drivemaxusedcars.com.
# Use the existing Namecheap mailbox (no Resend plan required for alerts).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=sales@drivemaxusedcars.com
SMTP_PASSWORD=
# Random server-only secret for the protected retry endpoint / Vercel cron.
CRON_SECRET=
# Optional alternative for website alerts; still required for CRM outbound email.
RESEND_API_KEY=
# Optional override; defaults to Drive Max <sales@drivemaxusedcars.com>.
LEAD_EMAIL_FROM=
# Optional override; defaults to the Drive Max receiving domain uemoridela.resend.app.
LEAD_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=

# Production only: shared with the CRM project; protects its durable email worker.
CRM_EMAIL_WORKER_SECRET=
