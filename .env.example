# Enable only after applying the migration and creating your first staff user.
CONTROL_ROOM_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Hash salt for rate limits: generate a random 32-byte value. Never NEXT_PUBLIC.
LEAD_RATE_LIMIT_SECRET=
RESEND_API_KEY=
LEAD_EMAIL_FROM=
# Receiving-only subdomain, e.g. replies.drivemaxusedcars.com. Do not replace your mailbox MX.
LEAD_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
